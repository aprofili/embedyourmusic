{
  "manifest_version": 3,
  "name": "EmbedYourMusic",
  "version": "1.25.1",
  "description": "Turns Spotify and Bandcamp links on rateyourmusic.com into inline embedded players.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "identity",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "*://rateyourmusic.com/*",
    "*://*.rateyourmusic.com/*",
    "*://*.bandcamp.com/*",
    "https://api.spotify.com/*",
    "https://itunes.apple.com/*",
    "https://api.deezer.com/*",
    "https://accounts.spotify.com/*",
    "*://*.snmc.io/*",
    "*://*.sonemic.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://rateyourmusic.com/*",
        "*://*.rateyourmusic.com/*"
      ],
      "js": [
        "content.js",
        "release-data.js",
        "recommendations.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://rateyourmusic.com/artist/*",
        "*://*.rateyourmusic.com/artist/*"
      ],
      "js": [
        "artist-ratings.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://rateyourmusic.com/recommendations/*",
        "*://*.rateyourmusic.com/recommendations/*"
      ],
      "js": [
        "release-data.js",
        "reco-ratings.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://rateyourmusic.com/*",
        "*://*.rateyourmusic.com/*"
      ],
      "js": [
        "main-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "strip_csp",
        "enabled": false,
        "path": "rules.json"
      },
      {
        "id": "cover_referer",
        "enabled": true,
        "path": "referer-rules.json"
      }
    ]
  },
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "EmbedYourMusic player",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "media-play-pause": {
      "suggested_key": {
        "default": "MediaPlayPause"
      },
      "description": "Play / pause the sidebar player"
    },
    "media-next": {
      "suggested_key": {
        "default": "MediaNextTrack"
      },
      "description": "Next song"
    },
    "media-prev": {
      "suggested_key": {
        "default": "MediaPrevTrack"
      },
      "description": "Previous song"
    }
  }
}
