{
  "manifest_version": 3,
  "name": "EmbedYourMusic",
  "version": "1.0.0",
  "description": "Turns Spotify and Bandcamp links on rateyourmusic.com into inline embedded players.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://rateyourmusic.com/*",
    "*://*.rateyourmusic.com/*",
    "*://*.bandcamp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://rateyourmusic.com/*",
        "*://*.rateyourmusic.com/*"
      ],
      "js": [
        "content.js",
        "recommendations.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://rateyourmusic.com/artist/*",
        "*://*.rateyourmusic.com/artist/*"
      ],
      "js": [
        "artist-ratings.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "strip_csp",
        "enabled": false,
        "path": "rules.json"
      }
    ]
  }
}
